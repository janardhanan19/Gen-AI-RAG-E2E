{
  "name": "rag-resume-search",
  "version": "0.1.0",
  "description": "RAG-based Resume Search API (Node.js + Express + TypeScript + MongoDB)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx scripts/ingest-resumes.ts"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@types/multer": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mammoth": "^1.12.0",
    "mongodb": "^6.6.0",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pino": "^9.0.0",
    "pino-http": "^10.2.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.8",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
